---
import { autorNode } from '../../lib/autor';
/**
 * Schema de página EV — @graph com BreadcrumbList + Article + Thing(Vehicle) + HowTo? + FAQPage.
 *
 * Mesma regra da ficha técnica: o nó da entidade não declara @type Vehicle, porque
 * Vehicle é subtipo de Product e o Google reprova a família inteira sem
 * offers/review/aggregateRating. Identidade vai em Thing + additionalType.
 * Template F do plano de schema.
 */
interface Props {
  data: any;
  url: string;
  breadcrumb: { name: string; item?: string }[];
}
import { getMarcaPorNome } from '../../lib/marcas';

const { data, url, breadcrumb } = Astro.props;
const site = 'https://hachiroku.com.br';
const nome = `${data.entidade.marca} ${data.entidade.modelo}`;

/**
 * O nó Vehicle só sai quando a marca do frontmatter resolve contra marcas.ts.
 *
 * Rótulos editoriais como "Geral", "Genérico" e "Comparativo" não são fabricantes:
 * emitir Vehicle a partir deles fazia o grafo afirmar a existência de uma montadora
 * chamada "Geral". Quando não resolve, o Vehicle e o `about` que aponta para ele
 * saem juntos — deixar o `about` sozinho apenas trocaria o defeito por uma
 * referência pendurada em nó inexistente.
 */
const marcaResolvida = getMarcaPorNome(data.entidade.marca);
const temVeiculo = Boolean(marcaResolvida);

const graph: any[] = [
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumb`,
    itemListElement: breadcrumb.map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      item: b.item ?? (i === breadcrumb.length - 1 ? url : undefined),
    })),
  },
  {
    '@type': 'TechArticle',
    '@id': `${url}#article`,
    headline: data.title,
    description: data.description,
    proficiencyLevel: 'Expert',
    ...(temVeiculo ? { about: { '@id': `${url}#vehicle` } } : {}),
    mentions: data.entidadesEssenciais.map((e: string) => ({ '@type': 'Thing', name: e })),
    datePublished: data.pubDate.toISOString().slice(0, 10),
    dateModified: (data.updatedDate ?? data.pubDate).toISOString().slice(0, 10),
    inLanguage: 'pt-BR',
    author: autorNode(data.autor, site),
    publisher: { '@id': `${site}/#organization` },
    isPartOf: { '@id': `${site}/#website` },
    mainEntityOfPage: url,
    ...(data.imagem ? { image: { '@type': 'ImageObject', url: `${site}${data.imagem}` } } : {}),
    speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.faq'] },
    hasPart: [
      ...(data.passos?.length ? [{ '@id': `${url}#howto` }] : []),
      ...(data.faq?.length ? [{ '@id': `${url}#faq` }] : []),
    ],
  },
];

if (temVeiculo) {
  graph.push({
    '@type': 'Thing',
    additionalType: 'https://schema.org/Vehicle',
    '@id': `${url}#vehicle`,
    name: nome,
    ...(data.entidade.tipo
      ? { disambiguatingDescription: `${nome}: ${data.entidade.tipo}, fabricado por ${marcaResolvida!.nome}.` }
      : {}),
    url,
    subjectOf: { '@id': `${url}#article` },
  });
  // A montadora é entidade própria. O sameAs dela é da MARCA, nunca do modelo:
  // pendurá-lo no nó do veículo faria o grafo afirmar que o carro é a montadora.
  graph.push({
    '@type': 'Organization',
    '@id': `${url}#marca`,
    name: marcaResolvida!.nome,
    ...(marcaResolvida!.sameAs?.length ? { sameAs: marcaResolvida!.sameAs } : {}),
  });
}

if (data.passos?.length) {
  graph.push({
    '@type': 'HowTo',
    '@id': `${url}#howto`,
    name: `Passo a passo: ${data.entidade.modelo}`,
    isPartOf: { '@id': `${url}#article` },
    step: data.passos.map((s: any, i: number) => ({ '@type': 'HowToStep', '@id': `${url}#howto-step-${i + 1}`, position: i + 1, name: s.nome, text: s.texto })),
  });
}
if (data.faq?.length) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    mainEntity: data.faq.map((f: any, i: number) => ({ '@type': 'Question', '@id': `${url}#faq-${i}`, name: f.pergunta, acceptedAnswer: { '@type': 'Answer', text: f.resposta } })),
  });
}

const jsonld = { '@context': 'https://schema.org', '@graph': graph };
---
<script type="application/ld+json" set:html={JSON.stringify(jsonld)} />

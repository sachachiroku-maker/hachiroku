---
import { autorNode } from '../../lib/autor';
/**
 * Schema de ficha técnica — @graph com BreadcrumbList + TechArticle + Thing(Vehicle) + FAQPage.
 *
 * O nó da entidade NÃO usa @type Vehicle. Vehicle é subtipo de Product, e o parser de
 * Product do Google reprova todo nó da família sem offers/review/aggregateRating — o
 * portal é editorial e não vende carro, então não há oferta legítima a declarar.
 * A identidade fica em Thing + additionalType, que preserva sameAs/Wikidata sem
 * entrar no radar do rich result de produto. As specs seguem nas tabelas HTML.
 * Gerado do frontmatter da collection `fichas` (Template B do plano de schema).
 */
import { modeloSameAs } from '../../lib/wikis';
import { fotoPorModelo } from '../../lib/fotos';

interface Props {
  data: any;
  url: string;
  breadcrumb: { name: string; item?: string }[];
}
const { data, url, breadcrumb } = Astro.props;
const site = 'https://hachiroku.com.br';
const nome = `${data.marca} ${data.modelo} ${data.ano} ${data.versao}`;
const fichaImagem = `${site}${fotoPorModelo(data.marca, data.modelo, 'ficha')}`;
const _fichaModeloKey = `${data.marca.toLowerCase()}/${data.modelo.toLowerCase().replace(/\s+/g, '-')}`;

// Descritor de desambiguação montado só com campos reais do frontmatter.
// Substitui as propriedades tipadas de Vehicle (brand/model/fuelType/bodyType), que
// não têm domínio válido em Thing. Nada aqui é inferido: campo ausente não entra.
const descritor = [
  data.carroceria,
  data.combustivel,
  data.cilindrada,
  data.versao,
].filter(Boolean).join(', ');

const graph: any[] = [
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumb`,
    itemListElement: breadcrumb.map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      item: b.item ?? (i === breadcrumb.length - 1 ? url : undefined),
    })),
  },
  {
    '@type': 'TechArticle',
    '@id': `${url}#article`,
    headline: data.seoTitle ?? data.title,
    description: data.description,
    proficiencyLevel: 'Expert',
    inLanguage: 'pt-BR',
    about: { '@id': `${url}#vehicle` },
    author: autorNode(data.autor, site),
    publisher: { '@id': `${site}/#organization` },
    datePublished: data.pubDate?.toISOString().slice(0, 10),
    dateModified: (data.updatedDate ?? data.pubDate)?.toISOString().slice(0, 10),
    mainEntityOfPage: url,
    image: {
      '@type': 'ImageObject',
      url: fichaImagem,
    },
    ...(data.faq?.length ? { hasPart: [{ '@id': `${url}#faq` }] } : {}),
  },
  {
    '@type': 'Thing',
    additionalType: 'https://schema.org/Vehicle',
    '@id': `${url}#vehicle`,
    name: nome,
    alternateName: `${data.marca} ${data.modelo}`,
    description: data.description,
    ...(descritor ? { disambiguatingDescription: `${data.marca} ${data.modelo} ${data.ano}: ${descritor}.` } : {}),
    image: fichaImagem,
    url,
    subjectOf: { '@id': `${url}#article` },
    ...(modeloSameAs(_fichaModeloKey) ? { sameAs: modeloSameAs(_fichaModeloKey) } : {}),
  },
];

if (data.faq?.length) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    mainEntity: data.faq.map((f: any, i: number) => ({
      '@type': 'Question',
      '@id': `${url}#faq-${i}`,
      name: f.pergunta,
      acceptedAnswer: { '@type': 'Answer', text: f.resposta },
    })),
  });
}

const jsonld = { '@context': 'https://schema.org', '@graph': graph };
---
<script type="application/ld+json" set:html={JSON.stringify(jsonld)} />

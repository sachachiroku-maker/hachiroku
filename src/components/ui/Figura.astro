---
/**
 * Figura (Astro) — imagem com crédito visível.
 *
 * Regra do silo: foto sem procedência não entra. Autor, licença e link para o
 * arquivo original ficam na legenda, não escondidos num rodapé de página.
 * Material Creative Commons exige isso; material próprio ganha o mesmo padrão
 * porque a atribuição visível também é sinal de E-E-A-T.
 */
interface Props {
  src: string;
  alt: string;
  largura: number;
  altura: number;
  legenda?: string;
  credito: string;
  fonteUrl?: string;
  licenca?: string;
  licencaUrl?: string;
  priority?: boolean;
  class?: string;
}
const {
  src, alt, largura, altura, legenda, credito,
  fonteUrl, licenca, licencaUrl, priority = false, class: cls = '',
} = Astro.props;
---
<figure class={`figura ${cls}`}>
  <img
    src={src}
    alt={alt}
    width={largura}
    height={altura}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    decoding="async"
  />
  <figcaption>
    {legenda && <span class="figura-legenda">{legenda}</span>}
    <span class="figura-credito">
      Foto: {fonteUrl ? <a href={fonteUrl} target="_blank" rel="noopener">{credito}</a> : credito}
      {licenca && (
        <>
          {' · '}
          {licencaUrl ? <a href={licencaUrl} target="_blank" rel="noopener nofollow">{licenca}</a> : licenca}
        </>
      )}
    </span>
  </figcaption>
</figure>

<style>
  .figura { margin: 2rem 0; }
  .figura img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line, rgba(255, 255, 255, 0.12));
    border-radius: 6px;
  }
  .figura figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: 0.6rem;
    font-size: 0.86rem;
    line-height: 1.45;
  }
  .figura-credito { opacity: 0.7; font-size: 0.8rem; }
</style>

---
/**
 * Video (Astro) — fachada de YouTube sem custo de terceiro.
 *
 * Nada do YouTube é carregado até o leitor clicar: o pôster é uma cópia local
 * em WebP e o iframe (youtube-nocookie) só é criado no clique. Isso preserva o
 * Lighthouse 100 do site, que um embed nativo derruba sozinho, e evita cookie
 * de terceiro em quem só passou pela página.
 *
 * O <noscript> devolve um link direto — o vídeo nunca fica inacessível.
 */
interface Props {
  id: string;          // ID de 11 caracteres, já conferido no oEmbed
  titulo: string;      // título real devolvido pela API, não parafraseado
  canal: string;
  data?: string;
  nota?: string;
  poster?: string;     // cópia local; cai para o i.ytimg se ausente
  priority?: boolean;
}
const { id, titulo, canal, data, nota, poster, priority = false } = Astro.props;
const capa = poster ?? `/img/preparacao/video/${id}.webp`;
const url = `https://www.youtube.com/watch?v=${id}`;
---
<figure class="video-embed">
  <div class="video-facade" data-video-id={id} data-titulo={titulo}>
    <button type="button" class="video-play" aria-label={`Assistir "${titulo}", do canal ${canal}, no YouTube`}>
      <img
        src={capa}
        alt=""
        width="960"
        height="540"
        loading={priority ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={priority ? 'high' : undefined}
      />
      <span class="video-icone" aria-hidden="true">
        <svg viewBox="0 0 68 48" width="68" height="48" focusable="false">
          <path class="video-icone-fundo" d="M66.5 7.7a8.6 8.6 0 0 0-6-6.1C55.2 0 34 0 34 0S12.8 0 7.5 1.6a8.6 8.6 0 0 0-6 6.1A90 90 0 0 0 0 24a90 90 0 0 0 1.5 16.3 8.6 8.6 0 0 0 6 6.1C12.8 48 34 48 34 48s21.2 0 26.5-1.6a8.6 8.6 0 0 0 6-6.1A90 90 0 0 0 68 24a90 90 0 0 0-1.5-16.3z" />
          <path d="M45 24 27 14v20l18-10z" fill="#fff" />
        </svg>
      </span>
    </button>
  </div>
  <figcaption>
    <strong>{titulo}</strong>
    <span class="video-credito">
      {canal}{data ? ` · ${data}` : ''} · <a href={url} target="_blank" rel="noopener">ver no YouTube</a>
    </span>
    {nota && <span class="video-nota">{nota}</span>}
  </figcaption>
  <noscript>
    <p><a href={url} target="_blank" rel="noopener">Assistir "{titulo}" no YouTube</a> ({canal})</p>
  </noscript>
</figure>

<script>
  // Delegação única para a página inteira: Astro empacota este script uma vez,
  // independente de quantos vídeos o artigo tiver.
  document.addEventListener('click', (ev) => {
    const alvo = ev.target as HTMLElement | null;
    const botao = alvo?.closest?.('.video-facade .video-play');
    if (!botao) return;
    const facade = botao.closest('.video-facade') as HTMLElement | null;
    const id = facade?.dataset.videoId;
    if (!facade || !id) return;

    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`;
    iframe.title = facade.dataset.titulo ?? 'Vídeo do YouTube';
    iframe.width = '960';
    iframe.height = '540';
    iframe.loading = 'lazy';
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    iframe.allowFullscreen = true;
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    facade.replaceChildren(iframe);
  });
</script>

<style>
  .video-embed { margin: 2rem 0; }
  .video-facade {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
    border: 1px solid var(--line, rgba(255, 255, 255, 0.12));
    border-radius: 6px;
    overflow: hidden;
  }
  .video-facade :is(img, iframe) { width: 100%; height: 100%; display: block; border: 0; }
  .video-facade img { object-fit: cover; }
  .video-play {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .video-icone {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
  }
  .video-icone-fundo { fill: #212121; fill-opacity: 0.82; transition: fill-opacity 0.15s ease; }
  .video-play:hover .video-icone-fundo,
  .video-play:focus-visible .video-icone-fundo { fill: #f00; fill-opacity: 1; }
  .video-play:focus-visible { outline: 2px solid var(--redline-500, #e63946); outline-offset: 2px; }
  .video-embed figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: 0.6rem;
    font-size: 0.86rem;
    line-height: 1.45;
  }
  .video-credito { opacity: 0.72; }
  .video-nota { opacity: 0.85; font-style: italic; }
  @media (prefers-reduced-motion: reduce) {
    .video-icone-fundo { transition: none; }
  }
</style>

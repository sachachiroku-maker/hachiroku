---
/**
 * Mapa de camadas de página — ferramenta de desenvolvimento.
 *
 * Injetada só no `astro dev` (integração hachiroku:dev-camadas em astro.config.mjs),
 * em /dev/camadas/. Não existe no build, no sitemap nem na Vercel.
 *
 * Mostra os templates do site agrupados nas 4 camadas, com a contagem real de páginas
 * (calculada das content collections e das libs de entidade), um exemplo navegável e
 * uma prévia em iframe de cada template. O registro das camadas está em ./camadas.ts.
 */
import '../styles/tokens/fonts.css';
import '../styles/tokens/colors.css';
import '../styles/tokens/typography.css';
import '../styles/tokens/spacing.css';
import '../styles/tokens/base.css';
import { getCollection } from 'astro:content';
import { CAMADAS, CASCA, type Template } from './camadas';
import { MARCAS } from '../lib/marcas';
import { motores, tecnologias } from '../lib/entidades';
import { SISTEMAS } from '../lib/sistemas';

const publicados = async (c: string) =>
  (await getCollection(c as any, ({ data }: any) => !data.draft)).map((e: any) => e.id as string).sort();

// Hubs de modelo: mesma regra do getStaticPaths de problemas/[marca]/[modelo]
const idsProblemas = await publicados('problemas');
const hubsModelo = [...new Set(idsProblemas.filter((id) => id.split('/').length >= 3).map((id) => id.split('/').slice(0, 2).join('/')))]
  .map((mm) => `/problemas/${mm}/`);

const gruposEntidade = [
  { rotulo: 'Modelo', urls: hubsModelo },
  { rotulo: 'Marca', urls: MARCAS.map((m) => `/marca/${m.slug}/`) },
  { rotulo: 'Motor', urls: motores().map((e) => `/motor/${e.slug}/`) },
  { rotulo: 'Tecnologia', urls: tecnologias().map((e) => `/tecnologia/${e.slug}/`) },
  { rotulo: 'Sistema', urls: SISTEMAS.map((s) => `/sistema/${s.slug}/`) },
];

async function urlsDo(t: Template): Promise<string[]> {
  const f = t.fonte;
  if (f.tipo === 'fixas') return f.urls;
  if (f.tipo === 'entidades') return gruposEntidade.flatMap((g) => g.urls);
  const ids = f.colecao === 'problemas' ? idsProblemas : await publicados(f.colecao);
  return ids.map((id) => `${f.prefixo}${id}/`);
}

function exemploDo(t: Template, urls: string[]): string {
  const f = t.fonte;
  if (f.tipo === 'colecao' && f.preferir) return urls.find((u) => u.includes(f.preferir!)) ?? urls[0];
  if (f.tipo === 'entidades') return urls.find((u) => u.includes('chevrolet/onix')) ?? urls[0];
  return urls[0];
}

const camadas = await Promise.all(CAMADAS.map(async (c) => {
  const templates = await Promise.all(c.templates.map(async (t) => {
    const urls = await urlsDo(t);
    return { ...t, urls, exemplo: exemploDo(t, urls) };
  }));
  return { ...c, templates, total: templates.reduce((s, t) => s + t.urls.length, 0) };
}));

const totalTemplates = camadas.reduce((s, c) => s + c.templates.length, 0);
const totalPaginas = camadas.reduce((s, c) => s + c.total, 0);
const fmt = (n: number) => n.toLocaleString('pt-BR');
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Camadas de página · Hachiroku (dev)</title>
  <link rel="icon" href="/logos/hachiroku-badge-86-red.png" />
  <script is:inline>
    try {
      var t = localStorage.getItem('hk-theme') || 'light';
      document.documentElement.setAttribute('data-theme', t);
    } catch (e) {}
  </script>
</head>
<body>
  <header class="topo">
    <div class="wrap topo-row">
      <div>
        <p class="eyebrow">Hachiroku · ferramenta de desenvolvimento · só em <code>astro dev</code></p>
        <h1>Camadas de página</h1>
        <p class="sub">Todo template do site, agrupado pela função que a página cumpre. A estrutura (rotas, dados, schema, ordem dos blocos) fica fixa; a repaginada visual troca só a pele: tokens, <code>site.css</code> e a marcação de apresentação.</p>
      </div>
      <button class="tema" type="button" aria-label="Alternar tema claro/escuro"
        onclick="var d=document.documentElement;var n=d.getAttribute('data-theme')==='dark'?'light':'dark';d.setAttribute('data-theme',n);try{localStorage.setItem('hk-theme',n)}catch(e){}">◐ tema</button>
    </div>
    <div class="wrap kpis">
      <div class="kpi"><span class="kpi-n">{totalTemplates}</span><span class="kpi-l">templates</span></div>
      {camadas.map((c) => (
        <a class="kpi" href={`#camada-${c.numero}`}><span class="kpi-n">{fmt(c.total)}</span><span class="kpi-l">camada {c.numero} · {c.nome.toLowerCase()}</span></a>
      ))}
      <div class="kpi"><span class="kpi-n">{fmt(totalPaginas)}</span><span class="kpi-l">páginas HTML (sem redirects)</span></div>
    </div>
  </header>

  <main class="wrap">
    <!-- DIAGRAMA: a casca envolve as 4 camadas -->
    <section class="bloco" aria-labelledby="h-diagrama">
      <h2 id="h-diagrama" class="h2">Visão geral</h2>
      <div class="casca">
        <div class="casca-faixa">Camada 0 · Casca — <code>BaseLayout.astro</code>: faixa utilitária, cabeçalho com nav, rodapé, cookies. Presente em 100% das páginas.</div>
        {camadas.map((c) => (
          <div class={`faixa faixa-${c.numero}`}>
            <a class="faixa-rot" href={`#camada-${c.numero}`}>
              <span class="faixa-n">{c.numero}</span>
              <span><strong>{c.nome}</strong><small>{fmt(c.total)} páginas</small></span>
            </a>
            <div class="faixa-chips">
              {c.templates.map((t) => (
                <a class="chip" href={`#${t.id}`}><span class="chip-id">{t.id}</span> {t.nome}<span class="chip-n">{fmt(t.urls.length)}</span></a>
              ))}
            </div>
          </div>
        ))}
        <div class="casca-faixa">Rodapé da casca — 4 colunas de links + linha legal com âncoras para a camada 4.</div>
      </div>
      <p class="nota">A camada é definida pela <strong>função</strong>, não pela profundidade da URL: <code>/problemas/chevrolet/onix/</code> está no 3º nível de URL, mas agrega diagnósticos, então é hub (camada 2).</p>
    </section>

    <!-- CAMADA 0 -->
    <section class="bloco" id="camada-0" aria-labelledby="h-c0">
      <div class="camada-head">
        <span class="camada-num">0</span>
        <div><h2 id="h-c0" class="h2">Casca global</h2><p class="camada-res">O que envolve todas as páginas. Mudar aqui muda o site inteiro de uma vez — é o primeiro alvo de qualquer repaginada.</p></div>
      </div>
      <div class="grid-2">
        <div class="card">
          <h3>Estrutura — <code>{CASCA.layout}</code></h3>
          <ol class="anat">{CASCA.blocos.map((b) => <li>{b}</li>)}</ol>
        </div>
        <div class="card">
          <h3>Pele — onde o visual mora</h3>
          <ol class="anat">{CASCA.estilos.map((b) => <li>{b}</li>)}</ol>
        </div>
      </div>
    </section>

    {camadas.map((c) => (
      <section class="bloco" id={`camada-${c.numero}`} aria-labelledby={`h-c${c.numero}`}>
        <div class="camada-head">
          <span class={`camada-num cn-${c.numero}`}>{c.numero}</span>
          <div>
            <h2 id={`h-c${c.numero}`} class="h2">{c.nome} <small>{c.templates.length} {c.templates.length === 1 ? 'template' : 'templates'} · {fmt(c.total)} páginas</small></h2>
            <p class="camada-res">{c.resumo}</p>
          </div>
        </div>

        <div class="templates">
          {c.templates.map((t) => (
            <article class="card tpl" id={t.id}>
              <header class="tpl-head">
                <span class="tpl-id">{t.id}</span>
                <h3>{t.nome}</h3>
                <span class="tpl-n" title="páginas geradas por este template">{fmt(t.urls.length)}</span>
              </header>
              <p class="tpl-papel">{t.papel}</p>
              <dl class="tpl-meta">
                <div><dt>Rota</dt><dd><code>{t.rota}</code></dd></div>
                <div><dt>Schema</dt><dd>{t.schema}</dd></div>
                <div><dt>Arquivos</dt><dd>{t.arquivos.map((a) => <code class="arq">{a}</code>)}</dd></div>
              </dl>

              <p class="mini">Anatomia (ordem na página)</p>
              <ol class="anat">{t.blocos.map((b) => <li>{b}</li>)}</ol>

              {t.variantes && (
                <>
                  <p class="mini">Variantes e observações</p>
                  <ul class="vari">{t.variantes.map((v) => <li>{v}</li>)}</ul>
                </>
              )}

              <div class="acoes">
                <a class="btn" href={t.exemplo} target="_blank" rel="noopener">Abrir exemplo ↗</a>
                <code class="exemplo">{t.exemplo}</code>
              </div>

              <details class="prev" data-src={t.exemplo}>
                <summary>Prévia do template</summary>
                <div class="prev-box"><div class="prev-frame"></div></div>
              </details>

              {t.urls.length > 1 && (
                <details class="urls">
                  <summary>Todas as {fmt(t.urls.length)} URLs</summary>
                  {t.fonte.tipo === 'entidades'
                    ? gruposEntidade.map((g) => (
                        <div class="urls-grupo">
                          <p class="mini">{g.rotulo} · {g.urls.length}</p>
                          <ul>{g.urls.map((u) => <li><a href={u} target="_blank" rel="noopener">{u}</a></li>)}</ul>
                        </div>
                      ))
                    : <ul>{t.urls.map((u) => <li><a href={u} target="_blank" rel="noopener">{u}</a></li>)}</ul>}
                </details>
              )}
            </article>
          ))}
        </div>
      </section>
    ))}

    <p class="rodape">Registro: <code>src/dev/camadas.ts</code> · Documento: <code>docs/CAMADAS-DE-PAGINA.md</code> · Contagens calculadas das content collections a cada carregamento.</p>
  </main>

  <script is:inline>
    // Prévia: o iframe só é criado quando o <details> abre (evita compilar 18 páginas de uma vez).
    document.querySelectorAll('details.prev').forEach(function (d) {
      d.addEventListener('toggle', function () {
        if (!d.open) return;
        var box = d.querySelector('.prev-frame');
        if (!box.firstChild) {
          var f = document.createElement('iframe');
          f.src = d.getAttribute('data-src');
          f.title = 'Prévia de ' + d.getAttribute('data-src');
          f.loading = 'lazy';
          box.appendChild(f);
        }
        var ajusta = function () { box.style.setProperty('--s', String(box.parentElement.clientWidth / 1280)); };
        ajusta();
        new ResizeObserver(ajusta).observe(box.parentElement);
      });
    });
  </script>

  <style is:global>
    body { background: var(--bg-page); }
    .wrap { max-width: 1240px; margin-inline: auto; padding-inline: var(--space-4); }
    code { font-family: var(--font-mono); font-size: .86em; background: var(--bg-sunken); padding: .05em .35em; border-radius: var(--radius-xs); color: var(--text-strong); }

    .topo { background: var(--bg-ink-deep, #0f0e0a); color: var(--asphalt-0); padding-block: var(--space-12) var(--space-8); border-bottom: 3px solid var(--accent); }
    .topo h1 { color: var(--asphalt-0); font-size: var(--text-5xl); margin-block: var(--space-2); }
    .topo code { background: rgba(255,255,255,.08); color: var(--asphalt-100); }
    .topo-row { display: flex; gap: var(--space-6); justify-content: space-between; align-items: flex-start; }
    .eyebrow { font-family: var(--font-mono); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: var(--tracking-wider); color: var(--redline-400, #ff5a4a); }
    .sub { max-width: 760px; color: var(--asphalt-300); }
    .tema { background: transparent; border: 1px solid var(--asphalt-600); color: var(--asphalt-100); border-radius: var(--radius-pill); padding: var(--space-2) var(--space-4); font-family: var(--font-mono); font-size: var(--text-xs); cursor: pointer; flex-shrink: 0; }
    .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: var(--space-3); margin-top: var(--space-8); }
    .kpi { display: flex; flex-direction: column; gap: 2px; padding: var(--space-3) var(--space-4); border: 1px solid var(--asphalt-700); border-radius: var(--radius-md); color: inherit; }
    a.kpi:hover { border-color: var(--accent); color: inherit; }
    .kpi-n { font-family: var(--font-condensed); font-weight: var(--weight-extrabold); font-size: var(--text-3xl); line-height: 1; color: var(--asphalt-0); font-variant-numeric: tabular-nums; }
    .kpi-l { font-family: var(--font-mono); font-size: var(--text-2xs); text-transform: uppercase; letter-spacing: var(--tracking-wide); color: var(--asphalt-400); }

    .bloco { margin-block: var(--space-16); scroll-margin-top: var(--space-6); }
    .h2 { font-size: var(--text-3xl); margin-bottom: var(--space-4); }
    .h2 small { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: var(--weight-regular); color: var(--text-muted); letter-spacing: var(--tracking-wide); text-transform: uppercase; margin-left: var(--space-2); }
    .nota { margin-top: var(--space-4); color: var(--text-muted); font-size: var(--text-sm); }

    .casca { border: 2px dashed var(--border-strong); border-radius: var(--radius-lg); padding: var(--space-3); display: grid; gap: var(--space-2); }
    .casca-faixa { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--text-muted); padding: var(--space-2) var(--space-3); background: var(--bg-sunken); border-radius: var(--radius-sm); }
    .faixa { display: grid; grid-template-columns: 220px 1fr; gap: var(--space-3); align-items: center; padding: var(--space-3); background: var(--bg-surface); border: 1px solid var(--border-hairline); border-left: 4px solid var(--c, var(--accent)); border-radius: var(--radius-md); }
    .faixa-1 { --c: var(--redline-500); } .faixa-2 { --c: var(--amber-500); } .faixa-3 { --c: var(--beam-500); } .faixa-4 { --c: var(--asphalt-500); }
    .faixa-rot { display: flex; gap: var(--space-3); align-items: center; color: var(--text-strong); }
    .faixa-rot small { display: block; font-family: var(--font-mono); font-size: var(--text-2xs); color: var(--text-muted); text-transform: uppercase; }
    .faixa-n, .camada-num { font-family: var(--font-condensed); font-weight: var(--weight-extrabold); font-size: var(--text-3xl); line-height: 1; color: var(--c, var(--accent)); min-width: 1.2ch; }
    .faixa-chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }
    .chip { display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); padding: 4px 10px; border: 1px solid var(--border-hairline); border-radius: var(--radius-pill); color: var(--text-body); background: var(--bg-page); }
    .chip:hover { border-color: var(--c, var(--accent)); color: var(--text-strong); }
    .chip-id { font-family: var(--font-mono); font-size: var(--text-2xs); color: var(--text-muted); }
    .chip-n { font-family: var(--font-mono); font-size: var(--text-2xs); background: var(--bg-sunken); padding: 0 6px; border-radius: var(--radius-pill); font-variant-numeric: tabular-nums; }

    .camada-head { display: flex; gap: var(--space-4); align-items: flex-start; margin-bottom: var(--space-6); border-bottom: 1px solid var(--divider); padding-bottom: var(--space-4); }
    .camada-num { font-size: var(--text-6xl); }
    .cn-1 { --c: var(--redline-500); } .cn-2 { --c: var(--amber-500); } .cn-3 { --c: var(--beam-500); } .cn-4 { --c: var(--asphalt-500); }
    .camada-res { color: var(--text-muted); max-width: 820px; }

    .grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: var(--space-4); }
    .templates { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 560px), 1fr)); gap: var(--space-5); }
    .card { background: var(--bg-surface); border: 1px solid var(--border-hairline); border-radius: var(--radius-lg); padding: var(--space-5); box-shadow: var(--shadow-xs); scroll-margin-top: var(--space-6); }
    .card h3 { font-size: var(--text-lg); }
    .card:target { outline: 2px solid var(--accent); outline-offset: 2px; }
    .tpl-head { display: flex; align-items: baseline; gap: var(--space-3); }
    .tpl-head h3 { flex: 1; font-size: var(--text-xl); }
    .tpl-id { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--accent); }
    .tpl-n { font-family: var(--font-condensed); font-weight: var(--weight-extrabold); font-size: var(--text-3xl); line-height: 1; font-variant-numeric: tabular-nums; color: var(--text-strong); }
    .tpl-papel { color: var(--text-body); margin-block: var(--space-2) var(--space-4); }
    .tpl-meta { display: grid; gap: var(--space-2); margin: 0 0 var(--space-4); font-size: var(--text-sm); }
    .tpl-meta div { display: grid; grid-template-columns: 76px 1fr; gap: var(--space-2); }
    .tpl-meta dt { font-family: var(--font-mono); font-size: var(--text-2xs); text-transform: uppercase; color: var(--text-muted); padding-top: 3px; }
    .tpl-meta dd { margin: 0; display: flex; flex-wrap: wrap; gap: 4px; }
    .arq { font-size: var(--text-2xs); }
    .mini { font-family: var(--font-mono); font-size: var(--text-2xs); text-transform: uppercase; letter-spacing: var(--tracking-wide); color: var(--text-muted); margin: var(--space-3) 0 var(--space-1); }
    .anat { margin: 0; padding-left: 1.4em; font-size: var(--text-sm); display: grid; gap: 4px; }
    .anat li::marker { font-family: var(--font-mono); color: var(--accent); }
    .vari { margin: 0; padding-left: 1.2em; font-size: var(--text-sm); color: var(--text-muted); }
    .acoes { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); margin-top: var(--space-4); }
    .btn { display: inline-block; background: var(--accent); color: var(--text-on-accent, #fff); padding: 6px 14px; border-radius: var(--radius-sm); font-size: var(--text-sm); font-weight: var(--weight-semibold); }
    .btn:hover { background: var(--accent-hover); color: var(--text-on-accent, #fff); }
    .exemplo { font-size: var(--text-2xs); word-break: break-all; }
    details { margin-top: var(--space-3); border-top: 1px solid var(--divider); padding-top: var(--space-2); }
    summary { cursor: pointer; font-size: var(--text-sm); color: var(--text-strong); font-weight: var(--weight-semibold); }
    .prev-box { margin-top: var(--space-2); border: 1px solid var(--border-hairline); border-radius: var(--radius-md); overflow: hidden; aspect-ratio: 16 / 10; background: var(--bg-sunken); }
    .prev-frame { width: 1280px; height: 800px; transform: scale(var(--s, .4)); transform-origin: 0 0; }
    .prev-frame iframe { width: 1280px; height: 800px; border: 0; background: #fff; }
    .urls ul { columns: 2 260px; font-size: var(--text-xs); font-family: var(--font-mono); max-height: 320px; overflow: auto; padding-left: 1.2em; margin: var(--space-2) 0 0; }
    .urls li { break-inside: avoid; }
    .urls-grupo + .urls-grupo { margin-top: var(--space-2); }
    .rodape { font-size: var(--text-xs); color: var(--text-muted); margin-block: var(--space-12); text-align: center; }

    @media (max-width: 720px) {
      .topo-row { flex-direction: column; }
      .topo h1 { font-size: var(--text-4xl); }
      .faixa { grid-template-columns: 1fr; }
      .tpl-meta div { grid-template-columns: 1fr; }
    }
  </style>
</body>
</html>
